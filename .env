# iotronic-db
IOTRONIC_DB_NAME=iotronic
IOTRONIC_DB_USER=iotronic
IOTRONIC_DBPASS=unime

DB_CONNECTION_KEYSTONE=mysql+pymysql://keystone:unime@iotronic-db/keystone


DITTO_VERSION=3.9.6

# --- ports -------------------------------------------------------------
# 8080 is taken by iotronic-wstun on this host.
DITTO_EXTERNAL_PORT=8090

TZ=Europe/Rome

# --- credentials -------------------------------------------------------
# devops password guards /devops and /api/2/connections. Stage B needs it to
# create the AMQP connection. Generate one:
#   openssl rand -base64 24
DITTO_DEVOPS_PASSWORD=fUfwAKOKWXQTDZOZY/FyLm+8cCgqLveT

# The basic auth user for /api and /ws lives in conf_ditto/nginx.htpasswd,
# not here, because nginx reads a file. Record the username here so the
# provisioner and bootstrap know which subject to grant. Ditto sees it as
# "nginx:<this value>".
DITTO_API_USER=s4t
DITTO_API_PASSWORD=7aRA/3Xcyr1r//o7oO/sHt4V5q4HPyVj

# --- memory limits -----------------------------------------------------
# Defaults total roughly 3.0 GB. The JVMs use MaxRAMPercentage=50, so each
# service's heap is half its limit here. Tune to the factory server, then
# re-measure with: docker stats --no-stream
DITTO_MEM_MONGO=512m
DITTO_MEM_POLICIES=768m
DITTO_MEM_THINGS=768m
DITTO_MEM_SEARCH=640m
DITTO_MEM_CONNECTIVITY=896m
DITTO_MEM_GATEWAY=768m
DITTO_MEM_UI=64m
DITTO_MEM_NGINX=64m

# --- JVM ---------------------------------------------------------------
# Taken from the upstream Ditto compose file. ActiveProcessorCount=4 tells the
# JVM how many cores to assume, raise it if the server has plenty.
DITTO_JAVA_OPTS="-XX:ActiveProcessorCount=4 -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport -XX:+UseStringDeduplication -Xss512k -XX:MaxRAMPercentage=50 -XX:+UseG1GC -XX:MaxGCPauseMillis=150 -Dpekko.coordinated-shutdown.exit-jvm=on -Dpekko.cluster.shutdown-after-unsuccessful-join-seed-nodes=180s -Dpekko.cluster.failure-detector.threshold=15.0 -Dpekko.cluster.failure-detector.expected-response-after=10s -Dpekko.cluster.failure-detector.acceptable-heartbeat-pause=20s -Dpekko.cluster.downing-provider-class="

# Same, minus ExitOnOutOfMemoryError. Upstream warns that the AMQP client can
# throw OOM spuriously, and exiting on it puts connectivity in a restart loop.
DITTO_JAVA_OPTS_CONNECTIVITY="-XX:ActiveProcessorCount=4 -XX:+UseContainerSupport -XX:+UseStringDeduplication -Xss512k -XX:MaxRAMPercentage=50 -XX:+UseG1GC -XX:MaxGCPauseMillis=150 -Dpekko.coordinated-shutdown.exit-jvm=on -Dpekko.cluster.shutdown-after-unsuccessful-join-seed-nodes=180s -Dpekko.cluster.failure-detector.threshold=15.0 -Dpekko.cluster.failure-detector.expected-response-after=10s -Dpekko.cluster.failure-detector.acceptable-heartbeat-pause=20s -Dpekko.cluster.downing-provider-class="

# audit logger read token for the ledger developer, read only
AUDIT_API_TOKEN=72da16f68d1f4280c441efcf4f091d67374575eefc89714e
AUDIT_API_EXTERNAL_PORT=8890
AUDIT_RETENTION_DAYS=0
AUDIT_FAIL_CLOSED=0
