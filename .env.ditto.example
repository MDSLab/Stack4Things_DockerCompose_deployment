# ============================================================================
# Stage A additions. APPEND these to your existing .env, do not replace it.
# .env is already gitignored. Never commit real values.
# ============================================================================

# --- version -----------------------------------------------------------
# Pin it. Never run :latest against something you intend to measure, a
# re-pull silently changes what you measured.
DITTO_VERSION=3.9.6

# --- ports -------------------------------------------------------------
# 8080 is taken by iotronic-wstun on this host.
DITTO_EXTERNAL_PORT=8090

TZ=Europe/Rome

# --- credentials -------------------------------------------------------
# devops password guards /devops and /api/2/connections. Stage B needs it to
# create the AMQP connection. Generate one:
#   openssl rand -base64 24
DITTO_DEVOPS_PASSWORD=CHANGE_ME

# The basic auth user for /api and /ws lives in conf_ditto/nginx.htpasswd,
# not here, because nginx reads a file. Record the username here so the
# provisioner and bootstrap know which subject to grant. Ditto sees it as
# "nginx:<this value>".
DITTO_API_USER=s4t
DITTO_API_PASSWORD=CHANGE_ME

# --- memory limits -----------------------------------------------------
# Defaults total roughly 3.0 GB. The JVMs use MaxRAMPercentage=50, so each
# service's heap is half its limit here. Tune to the factory server, then
# re-measure with: docker stats --no-stream
DITTO_MEM_MONGO=512m
DITTO_MEM_POLICIES=512m
DITTO_MEM_THINGS=512m
DITTO_MEM_SEARCH=512m
DITTO_MEM_CONNECTIVITY=768m
DITTO_MEM_GATEWAY=512m
DITTO_MEM_UI=64m
DITTO_MEM_NGINX=64m

# --- JVM ---------------------------------------------------------------
# Taken from the upstream Ditto compose file. ActiveProcessorCount=2 tells the
# JVM how many cores to assume, raise it if the server has plenty.
DITTO_JAVA_OPTS=-XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport -XX:+UseStringDeduplication -Xss512k -XX:MaxRAMPercentage=50 -XX:+UseG1GC -XX:MaxGCPauseMillis=150 -Dpekko.coordinated-shutdown.exit-jvm=on -Dpekko.cluster.shutdown-after-unsuccessful-join-seed-nodes=180s -Dpekko.cluster.failure-detector.threshold=15.0 -Dpekko.cluster.failure-detector.expected-response-after=10s -Dpekko.cluster.failure-detector.acceptable-heartbeat-pause=20s -Dpekko.cluster.downing-provider-class=

# Same, minus ExitOnOutOfMemoryError. Upstream warns that the AMQP client can
# throw OOM spuriously, and exiting on it puts connectivity in a restart loop.
DITTO_JAVA_OPTS_CONNECTIVITY=-XX:ActiveProcessorCount=2 -XX:+UseContainerSupport -XX:+UseStringDeduplication -Xss512k -XX:MaxRAMPercentage=50 -XX:+UseG1GC -XX:MaxGCPauseMillis=150 -Dpekko.coordinated-shutdown.exit-jvm=on -Dpekko.cluster.shutdown-after-unsuccessful-join-seed-nodes=180s -Dpekko.cluster.failure-detector.threshold=15.0 -Dpekko.cluster.failure-detector.expected-response-after=10s -Dpekko.cluster.failure-detector.acceptable-heartbeat-pause=20s -Dpekko.cluster.downing-provider-class=

# AMQP virtual host. The default RabbitMQ vhost is "/". The bootstrap URL
# encodes it to %2F, because a bare trailing slash in an AMQP URI means the
# EMPTY vhost and RabbitMQ rejects it with 530 NOT_ALLOWED.
S4T_AMQP_VHOST=/

# --- audit logger, stages L1 to L5 -------------------------------------
# Token the ledger developer uses to read /audit/*. Read only, and separate
# from the twin layer credential so it can be revoked on its own:
#   openssl rand -hex 24
AUDIT_API_TOKEN=CHANGE_ME
AUDIT_API_EXTERNAL_PORT=8890

# 0 disables pruning. Deleting old rows never renumbers the sequence, so a
# consumer's cursor stays valid across a prune.
AUDIT_RETENTION_DAYS=0

# The proxy that captures operator identity forwards the request even when
# recording fails, so a logging fault cannot stop machine operation. The gap
# in the audit sequence makes the loss visible. Set to 1 to refuse instead.
AUDIT_FAIL_CLOSED=0
